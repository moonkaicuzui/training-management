# Gmail SMTP (for send_*.py scripts)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# AI API Keys (for local testing only — production uses Firebase Secrets)
GEMINI_API_KEY=
GEMINI_BACKUP_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
