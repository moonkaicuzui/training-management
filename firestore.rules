rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 인증된 사용자만 접근 가능
    function isAuthenticated() {
      return request.auth != null;
    }

    // 관리자 확인 (users 컬렉션의 role 필드 기반)
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // 트레이너 확인
    function isTrainer() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TRAINER' ||
         isAdmin());
    }

    // 허용된 이메일 도메인 확인 (회사 도메인만 허용)
    function hasAllowedDomain() {
      let email = request.auth.token.email;
      return email.matches('.*@hwaseung\\.com$') ||
             email.matches('.*@hwaseungvina\\.com$') ||
             email.matches('.*@hsvina\\.com$');
    }

    // 데이터 검증: 필수 필드 확인
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // 타임스탬프 검증
    function hasValidTimestamp(field) {
      return request.resource.data[field] is timestamp;
    }

    // 쓰기 속도 제한: 같은 문서에 1초 이내 연속 update 방지
    function isNotTooFrequent() {
      return !('updated_at' in resource.data) ||
        request.time > resource.data.updated_at + duration.value(1, 's');
    }

    // ========== 직원 ==========
    match /employees/{employeeId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if isAdmin();
    }

    // ========== 교육 프로그램 (snake_case: training_programs) ==========
    match /training_programs/{programId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if isAdmin();
    }

    // ========== 교육 세션 (snake_case: training_sessions) ==========
    match /training_sessions/{sessionId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if isAdmin();
    }

    // ========== 교육 결과 - 삭제 금지 (training_results) ==========
    match /training_results/{resultId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if false;  // 삭제 불가 - 감사 추적 필수
    }

    // ========== 프로그램 변경 로그 (program_change_logs) ==========
    match /program_change_logs/{logId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update, delete: if false;  // 로그는 수정/삭제 불가
    }

    // ========== 결과 수정 로그 (result_edit_logs) ==========
    match /result_edit_logs/{logId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update, delete: if false;  // 로그는 수정/삭제 불가
    }

    // ========== 트레이너 ==========
    match /trainers/{trainerId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 교육 계획 ==========
    match /trainingPlans/{planId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 출결 ==========
    match /attendances/{attendanceId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 감사 준수 ==========
    match /auditMetrics/{metricId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /auditFindings/{findingId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /correctiveActions/{actionId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 사용자 역할 정보 ==========
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ========== TQC 관련 컬렉션 ==========
    match /tqc_teams/{teamId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /tqc_trainees/{traineeId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if isAdmin();
    }

    match /tqc_training_stages/{stageId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /tqc_color_blind_tests/{testId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /tqc_meetings/{meetingId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if isAdmin();
    }

    match /tqc_resignations/{resignationId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if false;  // 퇴사 기록은 삭제 불가
    }

    // ========== 프로젝트 관리 ==========
    match /projects/{projectId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /project_members/{memberId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /project_tasks/{taskId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if isAdmin();
    }

    match /project_messages/{messageId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if isAuthenticated() && hasAllowedDomain() &&
        (resource.data.sender_id == request.auth.uid || isAdmin());
    }

    match /project_categories/{categoryId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /project_events/{eventId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /project_automations/{automationId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /project_notifications/{notificationId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update, delete: if isAuthenticated() && hasAllowedDomain() &&
        (resource.data.recipient_id == request.auth.uid || isAdmin());
    }

    match /project_settings/{settingsId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 교육 자료 ==========
    match /materials/{materialId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /materialFolders/{folderId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 효과성 평가 ==========
    match /evaluations/{evaluationId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 알림 ==========
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAuthenticated() && hasAllowedDomain() &&
        (resource.data.recipient_id == request.auth.uid || isAdmin());
    }

    match /notificationSettings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ========== CAPA (시정/예방 조치) ==========
    match /capas/{capaId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 재교육 대상 ==========
    match /retraining_targets/{targetId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 교육 비용 (ROI 분석용) ==========
    match /training_costs/{costId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 이수증 (certificates) - 삭제 금지, 취소만 가능 ==========
    match /certificates/{certificateId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain() && isNotTooFrequent();
      allow delete: if false;  // 이수증은 삭제 불가 - 취소(revoke)만 가능
    }

    // ========== 이수증 템플릿 (certificate_templates) ==========
    match /certificate_templates/{templateId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 감사 로그 (APPEND-ONLY: 수정/삭제 불가) ==========
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update, delete: if false;  // 감사 로그는 수정/삭제 불가
    }

    // ========== 역량 관리 (Competency Matrix & Skill Gap) ==========
    match /competencies/{competencyId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /employee_competencies/{ecId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /learning_paths/{pathId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /employee_learning_paths/{elpId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    match /development_plans/{planId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // ========== 5PRS 교육 추천 시스템 ==========

    // 불량유형-교육프로그램 매핑
    match /defect_training_mappings/{mappingId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // 추천 임계값 설정 (싱글톤)
    match /recommendation_thresholds/{thresholdId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create, update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if false;  // 삭제 불가
    }

    // TQC-직원 연결
    match /tqc_employee_links/{linkId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update: if isAuthenticated() && hasAllowedDomain();
      allow delete: if isAdmin();
    }

    // 5PRS 등록 감사 로그 (APPEND-ONLY)
    match /five_prs_enrollment_logs/{logId} {
      allow read: if isAuthenticated() && hasAllowedDomain();
      allow create: if isAuthenticated() && hasAllowedDomain();
      allow update, delete: if false;  // 감사 로그는 수정/삭제 불가
    }
  }
}
